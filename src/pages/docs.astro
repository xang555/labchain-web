  }

  /* Main Content */
  .docs-main {
    margin-left: 280px;
    padding: 80px 48px 48px 80px;
    max-width: calc(100% - 280px);
  }

  .docs-content {
    max-width: 800px;
  }

  /* Header */
  .docs-header {
    margin-bottom: 48px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
